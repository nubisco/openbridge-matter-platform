{
  "name": "@nubisco/openbridge-matter-platform",
  "version": "0.0.0-development",
  "description": "OpenBridge plugin that reads Matter devices already in Apple Home (or any Matter ecosystem) by joining them as a second controller, locally, without showing them twice in HomeKit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nubisco/openbridge-matter-platform.git"
  },
  "author": "Jos\u00e9 Silva <jose@nubisco.io>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "openbridge-plugin",
    "matter",
    "thread",
    "multi-admin",
    "apple-home",
    "local"
  ],
  "openbridge": {
    "platform": "MatterPlatform",
    "displayName": "Matter Platform"
  },
  "engines": {
    "node": ">=22.13"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "config.schema.json",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint --fix src/ tests/",
    "types:check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality:check": "npm test && npm run lint && npm run format:check && npm run types:check",
    "docs:dev": "nubisco-docs dev docs",
    "docs:build": "nubisco-docs build docs",
    "docs:preview": "nubisco-docs preview docs",
    "prepare": "[ -n \"$CI\" ] || simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && npm run quality:check",
    "pre-push": "npm run quality:check && npm run build"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "npm run lint:fix",
      "npm run format"
    ],
    "*.{json,md,mts,mjs}": "npm run format"
  },
  "dependencies": {
    "@matter/main": "0.18.0"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]"
        }
      ]
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nubisco/docs-sdk": "^0.5.1",
    "@nubisco/ui": "^5.49.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.1",
    "vue": "^3.5.44"
  }
}
